# Two worktrees of one project run side by side although the project hard-codes host port 8080.
# Hooks run, exec runs as the host user, exit codes pass through, and down/destroy clean up.

exec git init -q -b main shop
cp compose.yml shop/compose.yml
mkdir shop/www
cp index.html shop/www/index.html
exec git -C shop add -A
exec git -C shop commit -q -m init
exec git -C shop worktree add -q -b feature ../shop-feature

cd shop
exec mutti up
stdout '^'$MUTTI_TEST_RUN' is up'
exec mutti -C ../shop-feature up --json
stdout '"name": "'$MUTTI_TEST_RUN'-feature"'
stdout '"hostname": "feature.'$MUTTI_TEST_RUN'.localhost"'
stdout '"bootstrapped": true'

# Both run, each on its own random loopback port and its own hostname.
exec mutti list
stdout '^'$MUTTI_TEST_RUN' +running 2/2 +main +https://'$MUTTI_TEST_RUN'.localhost'
stdout '^'$MUTTI_TEST_RUN'-feature +running 2/2 +feature +https://feature.'$MUTTI_TEST_RUN'.localhost'
exec mutti list --json
stdout '"address": "127.0.0.1:[0-9]+"'
! stdout '8080'

# The bootstrap hook ran once per instance, in its own volume.
exec mutti exec db -- cat /data/seed
stdout '^seeded '$MUTTI_TEST_RUN'$'
exec mutti -C ../shop-feature exec db -- cat /data/seed
stdout '^seeded '$MUTTI_TEST_RUN'-feature$'

# exec runs as the host user and writes host-owned files into bind mounts.
exec mutti exec web -- sh -c 'id -u > /www/uid'
exec cat www/uid
exec id -u
cmp stdout www/uid

# Exit codes pass through unchanged.
exitcode 23 mutti exec web -- sh -c 'exit 23'

# With a terminal, exec gets one (shells, editors); without one it runs plain, as in CI.
[exec:script] exec script -qec 'mutti exec web -- sh -c "if test -t 0; then echo has-tty; fi"' /dev/null
[exec:script] stdout has-tty
exec mutti exec web -- sh -c 'test -t 0 || echo no-tty'
stdout no-tty

# A second up skips bootstrap.
exec mutti up --json
stdout '"bootstrapped": false'

# down keeps data, destroy removes it.
exec mutti down
exec mutti up
exec mutti exec db -- cat /data/seed
stdout seeded
exec mutti destroy --yes
stdout 'is gone'
exec mutti list
! stdout '^'$MUTTI_TEST_RUN' '

exec mutti -C ../shop-feature destroy --yes
exec mutti list
! stdout '^'$MUTTI_TEST_RUN

-- compose.yml --
x-mutti:
  name: ${MUTTI_TEST_RUN:?}
  hooks:
    bootstrap:
      - service: db
        run: echo "seeded $$MUTTI_INSTANCE" > /data/seed
        user: service
services:
  web:
    image: busybox:1.37
    command: ["httpd", "-f", "-p", "80", "-h", "/www"]
    init: true
    ports: ["8080:80"]
    volumes: ["./www:/www"]
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1/"]
      interval: 1s
      retries: 30
  db:
    image: busybox:1.37
    command: ["sleep", "infinity"]
    init: true
    volumes: ["data:/data"]
volumes:
  data:
-- index.html --
hello
